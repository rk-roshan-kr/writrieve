# Write4U Configuration
PORT=8000
HOST=127.0.0.1

# Open-Weight Model Runner
# Supports: local Ollama, vLLM, or Groq Open-Weights
LLM_PROVIDER=open_weights
LLM_MODEL=qwen2.5:8b-instruct
LLM_ENDPOINT=http://localhost:11434

# Optional: Groq Open-Weights API Key (for high-speed cloud Llama 3.3 70B / Qwen 2.5 32B)
# LLM_API_KEY=gsk_...

# Context Selection Tuning Parameters
LAMBDA_SIZE_PENALTY=0.05
MU_REDUNDANCY_PENALTY=0.15
