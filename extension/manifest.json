{
  "manifest_version": 3,
  "name": "Writrieve — Open-Weight Personal Context & Grounded Writing Engine",
  "version": "2.0.0",
  "description": "Native writing augmentation layer for Gmail, LinkedIn, and the web. Powered by Composio context, long-term memory, and open-weight models.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Write4U Context Engine"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://mail.google.com/*",
    "https://*.linkedin.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://*.linkedin.com/*",
        "<all_urls>"
      ],
      "js": [
        "core/site-adapter.js",
        "core/messaging.js",
        "core/injector.js",
        "sites/gmail.js",
        "sites/linkedin.js",
        "sites/substack.js",
        "sites/github.js",
        "sites/generic.js",
        "core/detector.js"
      ],
      "css": [
        "content/injected-ui.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/injected-ui.css",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
